# ==========================================
# Terraform Runtime & Temporary Files
# ==========================================
.terraform/
.terraform.lock.hcl
.terraform.tfstate.lock.info

# ==========================================
# Terraform State Files
# ==========================================
*.tfstate
*.tfstate.*
*.tfplan

# ==========================================
# Crash Logs & Overrides
# ==========================================
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ==========================================
# Version Control Settings
# Note: terraform.tfvars files are explicitly ALLOWED and TRACKED in git.
# ==========================================
!terraform.tfvars
!*.tfvars